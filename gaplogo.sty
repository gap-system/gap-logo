\def\DarkTheme{dark}
\def\LightTheme{light}
\def\BWTheme{bw}
\def\FourColorTheme{4c}
\def\GrayTheme{gray}

% colors for letter G, A, P in "GAP"
\definecolor{Gcolor}{named}{Crimson}
\definecolor{Acolor}{named}{Crimson}
\definecolor{Pcolor}{named}{Crimson}
\ifx\Theme\BWTheme
  \definecolor{Gcolor}{named}{Black}
  \definecolor{Acolor}{named}{Black}
  \definecolor{Pcolor}{named}{Black}
\fi
\ifx\Theme\GrayTheme
  \definecolor{Gcolor}{named}{Black}
  \definecolor{Acolor}{named}{Black}
  \definecolor{Pcolor}{named}{Black}
\fi

\definecolor{Tcolor}{named}{Black}
\ifx\Theme\DarkTheme
  \definecolor{Tcolor}{named}{WhiteSmoke}
\fi

% style for the letter G, A, P
\newcommand\gapstyle[1]{\textbf{\Huge#1}}

% style for the remaining letters
\ifx\ReducedMode\undefined
  \newcommand\extrastyle[1]{{\LARGE{}\textcolor{Tcolor}{#1}}}
\else
  \newcommand\extrastyle[1]{}
\fi

% styles for the logo

% base style for all four nodes
\tikzset{dynkinnode/.style={draw=Tcolor}}

% concrete styles for the four nodes
\tikzset{dynkinnodeZ/.style={dynkinnode}}
\tikzset{dynkinnodeA/.style={dynkinnode}}
\tikzset{dynkinnodeB/.style={dynkinnode}}
\tikzset{dynkinnodeC/.style={dynkinnode}}

% colors for the logo
\ifx\Theme\BWTheme
\else
  \ifx\Theme\GrayTheme
    %\tikzset{dynkinnodeZ/.append style={fill=Black}}
    \tikzset{dynkinnodeA/.append style={fill=Gray}}
    \tikzset{dynkinnodeB/.append style={fill=DarkGray}}
    \tikzset{dynkinnodeC/.append style={fill=LightGray}}
  \else
    \tikzset{dynkinnodeZ/.append style={fill=Crimson}}
    \ifx\Theme\FourColorTheme
      \tikzset{dynkinnodeA/.append style={fill=Gray}}
      \tikzset{dynkinnodeB/.append style={fill=DarkGray}}
      \tikzset{dynkinnodeC/.append style={fill=LightGray}}
    \else
      \tikzset{dynkinnodeA/.append style={fill=ForestGreen}}
      \tikzset{dynkinnodeB/.append style={fill=DodgerBlue}}
      \tikzset{dynkinnodeC/.append style={fill=Gold}}
    \fi
  \fi
\fi

% base style for all edges
\tikzset{dynkinedge/.style={draw=Tcolor}}

% concrete style for the three edges
\tikzset{dynkinedgeA/.style={dynkinedge}}
\tikzset{dynkinedgeB/.style={dynkinedge}}
\tikzset{dynkinedgeC/.style={dynkinedge}}

% base style for all arrows
\tikzset{dynkinarrow/.style={draw=Tcolor}}

% concrete style for the three edges
\tikzset{dynkinarrowAB/.style={dynkinarrow}}
\tikzset{dynkinarrowBC/.style={dynkinarrow}}
\tikzset{dynkinarrowCA/.style={dynkinarrow}}

\def \margin {22} % margin in angles, depends on the radius
\def\radius {10mm}  % radius for placement of the three outer nodes
\def\radiusB {9mm}  % radius for the arrows (drawn as circle arcs)
\def\noderadius {2.2mm}
\def\rotationangle {60}
